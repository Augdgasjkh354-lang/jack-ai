<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/l_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="10dp">
    <!-- 标题行：彩色小图标块、标题、右边一句（日期之类） -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <ImageView android:id="@+id/l_icon" android:layout_width="30dp" android:layout_height="30dp"
            android:padding="6dp" android:background="@drawable/widget_tag_teal" android:src="@drawable/ic_wt_calendar"
            android:contentDescription="@null" />
        <TextView android:id="@+id/l_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:textColor="@color/widget_text" android:textSize="17sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/l_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_hint" android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/l_1" style="@style/WidgetLine" />
    <TextView android:id="@+id/l_2" style="@style/WidgetLine" />
    <TextView android:id="@+id/l_3" style="@style/WidgetLine" />
    <TextView android:id="@+id/l_4" style="@style/WidgetLine" />
    <TextView android:id="@+id/l_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/widget_hint" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
