<?xml version="1.0" encoding="utf-8"?>
<!--
  只多放行一处明文 http：本机 127.0.0.1。ChatGPT 登录在 Kavi 浏览器里做完会跳回 http://127.0.0.1:端口/auth/callback，
  这个地址只在 App 自己里面（浏览器平时照样拦本机地址，见 BrowserNet.classify）。其余和系统默认一样。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
